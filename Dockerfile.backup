# syntax=docker/dockerfile:1.27
FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv

# Build on the runtime image so the virtualenv targets exactly the interpreter it
# ships with; only uv's static binary is copied in, not its bundled Python.
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
# uv fetches the canonical contracts package from its git source below, and the
# slim Python image ships no git client.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml api/pyproject.toml
COPY worker/pyproject.toml worker/pyproject.toml
COPY api/src api/src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-editable --project api

FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS python-runtime
# The runtime installs nothing: the virtualenv is built by uv. Drop the base
# image's pip, which vendors msgpack and setuptools releases with open advisories.
RUN python -m pip uninstall --yes --no-cache-dir pip

FROM postgres:18.6-trixie@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
LABEL org.opencontainers.image.title="Vonk Forge encrypted database operations" \
      org.opencontainers.image.source="https://github.com/CarstVaartjes/vonk-forge-web"
RUN apt-get update \
    && apt-get install --no-install-recommends -y age ca-certificates rclone \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 vonk \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent vonk \
    && rm -f /usr/local/bin/gosu /usr/local/bin/docker-entrypoint.sh \
        /usr/local/bin/docker-ensure-initdb.sh /usr/local/bin/docker-enforce-initdb.sh
COPY --from=python-runtime /usr/local /usr/local
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 api/src api/src
COPY --chmod=0555 scripts/backup-database scripts/restore-database scripts/verify-restored-database /app/scripts/
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
# Only the PostgreSQL client tools are used. The server entrypoint and its gosu
# privilege-drop helper (built with an unpatched Go toolchain) are removed above;
# the image already runs as a fixed non-root user.
ENTRYPOINT []
CMD ["/app/scripts/backup-database"]
