# syntax=docker/dockerfile:1.27
FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY web/src src
RUN npm run build

# The official Caddy image ships a binary built with an older Go toolchain and
# module set than the current security releases. Rebuild the same Caddy release
# with the standard module set on a current Go toolchain, raising only the
# dependencies that carry fixed HIGH/CRITICAL advisories. Module downloads are
# verified against go.sum and the Go checksum database.
FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS caddy
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY <<'EOF_MAIN' main.go
package main

import (
	caddycmd "github.com/caddyserver/caddy/v2/cmd"
	_ "github.com/caddyserver/caddy/v2/modules/standard"
)

func main() {
	caddycmd.Main()
}
EOF_MAIN
RUN --mount=type=cache,target=/root/go/pkg/mod \
    go mod init vonk.local/caddy \
    && go get \
        github.com/caddyserver/caddy/v2@v2.11.4 \
        golang.org/x/crypto@v0.57.0 \
        golang.org/x/net@v0.59.0 \
        golang.org/x/text@v0.42.0 \
        google.golang.org/grpc@v1.84.0 \
    && go mod tidy \
    && go build -ldflags "-s -w" -o /out/caddy . \
    && /out/caddy version

FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
LABEL org.opencontainers.image.title="Vonk Forge catalog web" \
      org.opencontainers.image.source="https://github.com/CarstVaartjes/vonk-forge-web"
COPY --from=caddy /out/caddy /usr/bin/caddy
COPY --chown=10001:10001 deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build --chown=10001:10001 /app/dist /srv
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/health/live"]
