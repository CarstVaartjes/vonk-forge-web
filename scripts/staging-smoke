#!/usr/bin/env bash
set -Eeuo pipefail

: "${VONK_STAGING_BASE_URL:?set VONK_STAGING_BASE_URL to the public web origin}"
base=${VONK_STAGING_BASE_URL%/}
case "${base}" in
  https://*) ;;
  http://127.0.0.1:*|http://localhost:*) ;;
  *) echo "smoke target must use HTTPS (except loopback)" >&2; exit 2 ;;
esac

smoke_tmp=$(mktemp -d)
cleanup() {
  rm -rf -- "${smoke_tmp:?}"
}
trap cleanup EXIT INT TERM

curl --fail --silent --show-error --max-time 15 "${base}/health/live" >"${smoke_tmp}/live.json"
curl --fail --silent --show-error --max-time 15 "${base}/health/ready" >"${smoke_tmp}/ready.json"
curl --fail --silent --show-error --max-time 15 "${base}/v1/auth/providers" >"${smoke_tmp}/providers.json"
curl --fail --silent --show-error --max-time 15 "${base}/v1/recipes?limit=1" >"${smoke_tmp}/recipes.json"

VONK_SMOKE_REQUIRE_OAUTH=${VONK_SMOKE_REQUIRE_OAUTH:-1} python3 - "${smoke_tmp}" <<'PY'
import json
import os
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
live = json.loads((root / "live.json").read_text())
ready = json.loads((root / "ready.json").read_text())
providers = json.loads((root / "providers.json").read_text())
recipes = json.loads((root / "recipes.json").read_text())
assert live["status"] == "live"
assert ready["status"] == "ready"
if os.environ["VONK_SMOKE_REQUIRE_OAUTH"] == "1":
    assert providers["providers"], "at least one OAuth provider must be enabled"
assert isinstance(recipes["items"], list)
assert "next_cursor" in recipes
print(json.dumps({"event": "staging.smoke_passed", "providers": providers["providers"]}))
PY
