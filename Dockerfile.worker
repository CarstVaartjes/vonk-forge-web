# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml api/pyproject.toml
COPY worker/pyproject.toml worker/pyproject.toml
COPY worker/src worker/src
COPY schemas schemas
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-editable --project worker

FROM python:3.14.7-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52
LABEL org.opencontainers.image.title="Vonk Forge catalog validation worker" \
      org.opencontainers.image.source="https://github.com/CarstVaartjes/vonk-forge-web"
RUN groupadd --gid 10001 vonk && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent vonk
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --from=build --chown=10001:10001 /app/schemas /app/schemas
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VONK_TEST_REPORT_SCHEMA=/app/schemas/test-report/v1.schema.json
USER 10001:10001
CMD ["python", "-m", "vonk_catalog_worker.main"]
