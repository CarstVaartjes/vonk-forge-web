# syntax=docker/dockerfile:1.27
FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv

# Build on the runtime image so the virtualenv targets exactly the interpreter it
# ships with; only uv's static binary is copied in, not its bundled Python.
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
# uv fetches the canonical contracts package from its git source below, and the
# slim Python image ships no git client.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
COPY api/pyproject.toml api/pyproject.toml
COPY worker/pyproject.toml worker/pyproject.toml
COPY worker/src worker/src
COPY schemas schemas
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-editable --project worker

FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
LABEL org.opencontainers.image.title="Vonk Forge catalog validation worker" \
      org.opencontainers.image.source="https://github.com/CarstVaartjes/vonk-forge-web"
RUN groupadd --gid 10001 vonk && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent vonk
WORKDIR /app
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --from=build --chown=10001:10001 /app/schemas /app/schemas
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VONK_TEST_REPORT_SCHEMA=/app/schemas/test-report/v1.schema.json
USER 10001:10001
CMD ["python", "-m", "vonk_catalog_worker.main"]
