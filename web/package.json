{
  "name": "vonk-catalog-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "postinstall": "npm ci --prefix tools/ts-api",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "biome ci .",
    "typecheck": "tsc -p tsconfig.json",
    "pretypecheck": "test -f src/api/catalog.generated.d.ts || npm run catalog",
    "catalog": "node scripts/recipe-release.mjs && node scripts/generate-catalog-types.mjs",
    "catalog:types": "node scripts/generate-catalog-types.mjs",
    "dev": "vite",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
